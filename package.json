{
  "name": "xai-desktop",
  "productName": "XAI",
  "version": "1.0.0",
  "description": "XAI: a local AI desktop assistant for Windows powered by Ollama models",
  "main": "main.js",
  "author": "Datix AI",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "ai.datix.xai",
    "productName": "XAI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png",
      "node_modules/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "XAI"
    }
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.9.0",
    "dompurify": "^3.1.6",
    "mammoth": "^1.8.0",
    "marked": "^12.0.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
